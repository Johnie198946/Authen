# 数据库配置
DATABASE_URL=postgresql://authuser:authpass123@localhost:5432/auth

# Redis配置
REDIS_URL=redis://localhost:6379/0

# RabbitMQ配置（当前生产未启用异步通知队列）
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://authuser:***@localhost:5672

# JWT配置
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# 应用配置
APP_NAME=Unified Auth Platform
APP_VERSION=1.0.0
DEBUG=True

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# OAuth配置
# 微信OAuth
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_OAUTH_MODE=website

# 支付宝OAuth
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_APP_PRIVATE_KEY=your_alipay_app_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key

# 精确允许的OAuth回调地址，多个地址以逗号分隔
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:5173/login/oauth/callback

# 仅限本地自动化测试；生产必须保持 false
ALLOW_DEBUG_VERIFICATION_CODES=false

# 阿里云短信验证码（密钥只通过部署环境注入，禁止提交真实值）
SMS_PROVIDER=aliyun
ALIBABA_CLOUD_ACCESS_KEY_ID=your_ram_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_ram_access_key_secret
ALIYUN_SMS_SIGN_NAME=深圳市时空感应网络科技
ALIYUN_SMS_TEMPLATE_CODE=SMS_511560412
ALIYUN_SMS_REGION_ID=cn-qingdao
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple OAuth
APPLE_CLIENT_ID=your_apple_client_id
APPLE_CLIENT_SECRET=your_apple_client_secret
